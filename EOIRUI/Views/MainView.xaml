<Window x:Class="EOIRUI.Views.MainView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="EO/IR Monitoring Server"
        Height="720"
        Width="1280"
        MinHeight="600"
        MinWidth="960"
        Background="#FF0B1120"
        Foreground="#FFF1F5F9"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="MinWidth" Value="88" />
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="Foreground" Value="#FFF8FAFC" />
            <Setter Property="Background" Value="#FF2563EB" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style x:Key="PortBadgeStyle" TargetType="Border">
            <Setter Property="Padding" Value="9,4" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="Background" Value="#FF334155" />
            <Setter Property="CornerRadius" Value="4" />
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="4,0,4,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock FontSize="25"
                           FontWeight="SemiBold"
                           Text="EO / IR MONITORING" />
                <TextBlock Margin="0,4,0,0"
                           Foreground="#FF94A3B8"
                           Text="Two RTSP clients / two UDP data receivers" />
            </StackPanel>

            <Button Grid.Column="1"
                    Margin="0,3,8,3"
                    Command="{Binding StartServerCommand}"
                    Content="서버 시작" />
            <Button Grid.Column="2"
                    Margin="0,3,0,3"
                    Background="#FF475569"
                    Command="{Binding StopServerCommand}"
                    Content="서버 중지" />
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Padding="12"
                    Background="#FF1E293B"
                    CornerRadius="8"
                    DataContext="{Binding EoCamera}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Margin="2,0,2,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock VerticalAlignment="Center"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Text="{Binding Name}" />
                        <Border Grid.Column="1" Style="{StaticResource PortBadgeStyle}">
                            <TextBlock FontSize="12" Foreground="#FFBFDBFE">
                                <Run Text="VIDEO " />
                                <Run Text="{Binding VideoIp}" />
                                <Run Text=":" />
                                <Run Text="{Binding VideoPort}" />
                            </TextBlock>
                        </Border>
                        <Border Grid.Column="2" Style="{StaticResource PortBadgeStyle}">
                            <TextBlock FontSize="12" Foreground="#FFC4B5FD">
                                <Run Text="DATA " />
                                <Run Text="{Binding DataIp}" />
                                <Run Text=":" />
                                <Run Text="{Binding DataPort}" />
                            </TextBlock>
                        </Border>
                    </Grid>

                    <Border x:Name="EoVideoSurface"
                            Grid.Row="1"
                            MinHeight="360"
                            Background="#FF020617"
                            BorderBrush="#FF334155"
                            BorderThickness="1"
                            CornerRadius="5">
                        <Grid>
                            <Grid x:Name="EoRtspHost" />
                            <StackPanel HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                <TextBlock HorizontalAlignment="Center"
                                           FontSize="22"
                                           FontWeight="SemiBold"
                                           Foreground="#FFCBD5E1"
                                           Text="EO RTSP VIDEO" />
                                <TextBlock HorizontalAlignment="Center"
                                           Margin="0,8,0,0"
                                           Foreground="#FF64748B"
                                           Text="RTSP 디코더 연결 대기" />
                            </StackPanel>
                            <Canvas x:Name="EoDataOverlay"
                                    Panel.ZIndex="10"
                                    IsHitTestVisible="False" />
                        </Grid>
                    </Border>

                    <Grid Grid.Row="2" Margin="2,10,2,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock FontSize="11"
                                       Foreground="#FF64748B"
                                       Text="VIDEO STATUS" />
                            <TextBlock Margin="0,3,0,0"
                                       Foreground="#FFCBD5E1"
                                       Text="{Binding VideoStatus}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock FontSize="11"
                                       Foreground="#FF64748B"
                                       Text="ADDITIONAL DATA" />
                            <TextBlock Margin="0,3,0,0"
                                       Foreground="#FFCBD5E1"
                                       Text="{Binding DataStatus}" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Column="2"
                    Padding="12"
                    Background="#FF1E293B"
                    CornerRadius="8"
                    DataContext="{Binding IrCamera}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Margin="2,0,2,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock VerticalAlignment="Center"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Text="{Binding Name}" />
                        <Border Grid.Column="1" Style="{StaticResource PortBadgeStyle}">
                            <TextBlock FontSize="12" Foreground="#FFFED7AA">
                                <Run Text="VIDEO " />
                                <Run Text="{Binding VideoIp}" />
                                <Run Text=":" />
                                <Run Text="{Binding VideoPort}" />
                            </TextBlock>
                        </Border>
                        <Border Grid.Column="2" Style="{StaticResource PortBadgeStyle}">
                            <TextBlock FontSize="12" Foreground="#FFFBCFE8">
                                <Run Text="DATA " />
                                <Run Text="{Binding DataIp}" />
                                <Run Text=":" />
                                <Run Text="{Binding DataPort}" />
                            </TextBlock>
                        </Border>
                    </Grid>

                    <Border x:Name="IrVideoSurface"
                            Grid.Row="1"
                            MinHeight="360"
                            Background="#FF020617"
                            BorderBrush="#FF334155"
                            BorderThickness="1"
                            CornerRadius="5">
                        <Grid>
                            <Grid x:Name="IrRtspHost" />
                            <StackPanel HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                <TextBlock HorizontalAlignment="Center"
                                           FontSize="22"
                                           FontWeight="SemiBold"
                                           Foreground="#FFCBD5E1"
                                           Text="IR RTSP VIDEO" />
                                <TextBlock HorizontalAlignment="Center"
                                           Margin="0,8,0,0"
                                           Foreground="#FF64748B"
                                           Text="RTSP 디코더 연결 대기" />
                            </StackPanel>
                            <Canvas x:Name="IrDataOverlay"
                                    Panel.ZIndex="10"
                                    IsHitTestVisible="False" />
                        </Grid>
                    </Border>

                    <Grid Grid.Row="2" Margin="2,10,2,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock FontSize="11"
                                       Foreground="#FF64748B"
                                       Text="VIDEO STATUS" />
                            <TextBlock Margin="0,3,0,0"
                                       Foreground="#FFCBD5E1"
                                       Text="{Binding VideoStatus}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock FontSize="11"
                                       Foreground="#FF64748B"
                                       Text="ADDITIONAL DATA" />
                            <TextBlock Margin="0,3,0,0"
                                       Foreground="#FFCBD5E1"
                                       Text="{Binding DataStatus}" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2"
                Margin="4,14,4,0"
                Padding="12,8"
                Background="#FF172033"
                CornerRadius="5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Ellipse Width="9"
                         Height="9"
                         Margin="0,0,9,0">
                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Setter Property="Fill" Value="#FF64748B" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsServerRunning}" Value="True">
                                    <Setter Property="Fill" Value="#FF22C55E" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>
                <TextBlock Grid.Column="1"
                           VerticalAlignment="Center"
                           Foreground="#FFCBD5E1"
                           Text="{Binding StatusMessage}" />
            </Grid>
        </Border>
    </Grid>
</Window>
