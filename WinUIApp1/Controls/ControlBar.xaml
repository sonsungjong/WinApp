<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="WinUIApp1.Controls.ControlBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WinUIApp1.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Background="{ThemeResource AcrylicBackgroundFillColorDefaultBrush}"
          Padding="16,12"
          CornerRadius="8,8,0,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- 스트리밍/재생 모드 토글 -->
        <ToggleButton x:Name="ModeToggle"
                      Grid.Column="0"
                      IsChecked="{x:Bind IsStreamingMode, Mode=TwoWay}"
                      Click="ModeToggle_Click"
                      Width="100"
                      Height="36">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <FontIcon Glyph="{x:Bind ModeIcon, Mode=OneWay}" FontSize="14"/>
                <TextBlock Text="{x:Bind ModeText, Mode=OneWay}" VerticalAlignment="Center"/>
            </StackPanel>
        </ToggleButton>

        <!-- 불러오기 버튼 -->
        <Button x:Name="LoadButton"
                Grid.Column="1"
                Content="불러오기"
                Click="LoadButton_Click"
                IsEnabled="{x:Bind IsPlaybackMode, Mode=OneWay}"
                Margin="8,0,0,0"
                Height="36"/>

        <!-- 재생/일시정지 버튼 -->
        <Button x:Name="PlayPauseButton"
                Grid.Column="2"
                Click="PlayPauseButton_Click"
                IsEnabled="{x:Bind HasLoadedFile, Mode=OneWay}"
                Margin="8,0,0,0"
                Width="48"
                Height="36">
            <FontIcon x:Name="PlayPauseIcon" Glyph="&#xE768;" FontSize="16"/>
        </Button>

        <!-- 타임라인 슬라이더 -->
        <Grid Grid.Column="3" Margin="16,0" VerticalAlignment="Center">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <Slider x:Name="TimelineSlider"
                    Grid.Row="0"
                    Minimum="0"
                    Maximum="{x:Bind TotalSeconds, Mode=OneWay}"
                    Value="{x:Bind CurrentSeconds, Mode=OneWay}"
                    IsEnabled="{x:Bind HasLoadedFile, Mode=OneWay}"
                    ValueChanged="TimelineSlider_ValueChanged"/>
            
            <Grid Grid.Row="1" Margin="0,2,0,0">
                <TextBlock x:Name="CurrentTimeText"
                           Text="{x:Bind CurrentTimeString, Mode=OneWay}"
                           FontSize="11"
                           Opacity="0.7"
                           HorizontalAlignment="Left"/>
                <TextBlock x:Name="TotalTimeText"
                           Text="{x:Bind TotalTimeString, Mode=OneWay}"
                           FontSize="11"
                           Opacity="0.7"
                           HorizontalAlignment="Right"/>
            </Grid>
        </Grid>

        <!-- 현재 재생 시간 표시 -->
        <TextBlock x:Name="PlaybackTimeText"
                   Grid.Column="4"
                   Text="{x:Bind PlaybackTimeString, Mode=OneWay}"
                   VerticalAlignment="Center"
                   FontSize="13"
                   Margin="8,0"/>

        <!-- 시간 이동 버튼 -->
        <Button x:Name="SeekButton"
                Grid.Column="5"
                Content="시간이동"
                Click="SeekButton_Click"
                IsEnabled="{x:Bind HasLoadedFile, Mode=OneWay}"
                Height="36"/>
    </Grid>
</UserControl>
