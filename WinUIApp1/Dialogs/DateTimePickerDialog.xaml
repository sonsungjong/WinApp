<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="WinUIApp1.Dialogs.DateTimePickerDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WinUIApp1.Dialogs"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="날짜/시간 선택"
    PrimaryButtonText="확인"
    SecondaryButtonText="취소"
    DefaultButton="Primary"
    PrimaryButtonClick="ContentDialog_PrimaryButtonClick">

    <StackPanel Spacing="16" MinWidth="300">
        <TextBlock Text="재생할 녹화 시간을 선택하세요"
                   TextWrapping="Wrap"
                   Opacity="0.8"/>

        <!-- 날짜 선택 -->
        <CalendarDatePicker x:Name="DatePicker"
                            Header="날짜"
                            PlaceholderText="날짜 선택"
                            HorizontalAlignment="Stretch"
                            DateChanged="DatePicker_DateChanged"/>

        <!-- 시간 선택 -->
        <TimePicker x:Name="TimePicker"
                    Header="시간"
                    ClockIdentifier="24HourClock"
                    HorizontalAlignment="Stretch"/>

        <!-- 선택된 시간 미리보기 -->
        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                CornerRadius="4"
                Padding="12">
            <StackPanel>
                <TextBlock Text="선택된 시간" FontWeight="SemiBold" FontSize="12" Opacity="0.6"/>
                <TextBlock x:Name="PreviewText"
                           Text="-"
                           FontSize="16"
                           Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <!-- 녹화 가능 날짜 안내 -->
        <TextBlock x:Name="AvailableDatesText"
                   Text=""
                   FontSize="12"
                   Opacity="0.6"
                   TextWrapping="Wrap"/>
    </StackPanel>
</ContentDialog>
