<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="WinUIApp1.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WinUIApp1"
    xmlns:controls="using:WinUIApp1.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="카메라 뷰어">

    <Grid x:Name="RootGrid" 
          Background="Black"
          PointerMoved="RootGrid_PointerMoved"
          PointerExited="RootGrid_PointerExited">
        
        <!-- 비디오 렌더링 영역 (SwapChainPanel) -->
        <SwapChainPanel x:Name="VideoPanel"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"/>

        <!-- 영상 신호 없음 메시지 -->
        <Grid x:Name="NoSignalOverlay"
              Visibility="Collapsed"
              Background="#80000000">
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="16">
                <FontIcon Glyph="&#xE714;"
                          FontSize="64"
                          Foreground="White"
                          Opacity="0.5"/>
                <TextBlock x:Name="StatusText"
                           Text="영상 신호가 없습니다"
                           FontSize="24"
                           Foreground="White"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- 상태 정보 (좌상단) -->
        <Border Background="#60000000"
                CornerRadius="4"
                Padding="8,4"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Margin="16">
            <StackPanel Orientation="Horizontal" Spacing="12">
                <!-- 연결 상태 -->
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <Ellipse x:Name="ConnectionIndicator"
                             Width="8" Height="8"
                             Fill="Gray"/>
                    <TextBlock x:Name="ConnectionText"
                               Text="연결 안됨"
                               Foreground="White"
                               FontSize="12"/>
                </StackPanel>

                <!-- 녹화 상태 -->
                <StackPanel x:Name="RecordingIndicator"
                            Orientation="Horizontal"
                            Spacing="4"
                            Visibility="Collapsed">
                    <Ellipse Width="8" Height="8" Fill="Red"/>
                    <TextBlock Text="녹화중"
                               Foreground="White"
                               FontSize="12"/>
                </StackPanel>

                <!-- 현재 시간 -->
                <TextBlock x:Name="CurrentTimeText"
                           Foreground="White"
                           FontSize="12"
                           Opacity="0.7"/>
            </StackPanel>
        </Border>

        <!-- 하단 컨트롤바 -->
        <controls:ControlBar x:Name="ControlBar"
                             VerticalAlignment="Bottom"
                             Opacity="0"
                             ModeToggleRequested="ControlBar_ModeToggleRequested"
                             LoadRequested="ControlBar_LoadRequested"
                             PlayPauseRequested="ControlBar_PlayPauseRequested"
                             SeekRequested="ControlBar_SeekRequested"
                             TimeJumpRequested="ControlBar_TimeJumpRequested">
            <controls:ControlBar.OpacityTransition>
                <ScalarTransition Duration="0:0:0.2"/>
            </controls:ControlBar.OpacityTransition>
        </controls:ControlBar>
    </Grid>
</Window>
